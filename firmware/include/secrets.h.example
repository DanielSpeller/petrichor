#pragma once

// Copy this file to secrets.h and fill in your real credentials.
// secrets.h is gitignored and must never be committed.

// WiFi credentials
constexpr char WIFI_SSID[] = "your_ssid";
constexpr char WIFI_PASSWORD[] = "your_password";

// MQTT broker
constexpr char MQTT_BROKER_HOST[] = "192.168.1.100";
constexpr uint16_t MQTT_BROKER_PORT = 1883;

// MQTT TLS
// Set to true to use WiFiClientSecure. Provide a PEM CA certificate to
// validate the broker, or leave it empty to call setInsecure() (useful for
// local testing only; never in production). Set to false to use plaintext.
constexpr bool MQTT_USE_TLS = false;
constexpr char MQTT_BROKER_CA_CERT[] = "";

// OTA password. Leave empty to allow unauthenticated OTA (not recommended
// outside a trusted local network).
constexpr char OTA_PASSWORD[] = "";
